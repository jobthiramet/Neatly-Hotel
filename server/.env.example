# Copy this file to server/.env, fill in the values, then run: .\run-supabase.ps1
# Supabase Dashboard → Project Settings → Database
# Use the Session pooler (port 5432), not Transaction pooler (port 6543).
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SPRING_PROFILES_ACTIVE=supabase
APP_CLIENT_ORIGIN=http://localhost:5173

# Keep each developer server from exhausting the shared database connection pool.
DB_POOL_MAX_SIZE=2
DB_POOL_MIN_IDLE=0
DB_POOL_IDLE_TIMEOUT=30000

# Supabase Dashboard → Project Settings → API
# Server-side only: never expose or commit the service role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=hotel-assets

# Supabase Storage - Profile Pictures
SUPABASE_STORAGE_BUCKET=profile-pictures
SUPABASE_PROFILE_STORAGE_BUCKET=profile-pictures
SUPABASE_ROOM_STORAGE_BUCKET=room-images

# Clerk Dashboard → API keys → Frontend API URL
# CLERK_ISSUER must be the issuer/Frontend API URL without a trailing slash.
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Must match the client origin used to obtain the Clerk session token.
CLERK_AUTHORIZED_PARTY=http://localhost:5173

# Stripe Dashboard → Developers → API keys (test mode).
# Prefer a restricted key (rk_test_…) that can create Checkout Sessions.
# Never commit real keys. Card checkout returns 503 when this is empty; cash still works.
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → signing secret (whsec_…).
# Local: stripe listen --forward-to localhost:8080/api/stripe/webhooks
STRIPE_WEBHOOK_SECRET=
