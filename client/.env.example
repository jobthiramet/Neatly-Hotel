# Copy this file to client/.env

# Clerk Dashboard → API keys → Publishable key
# This key is safe for the browser. Never use a secret key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Keep /api for local development — Vite proxies it to Spring Boot on :8080.
# Use the deployed API URL only when the client is not served by the same host.
VITE_API_BASE_URL=/api
