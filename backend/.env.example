# Backend — used with: ./mvnw spring-boot:run -Dspring-boot.run.profiles=supabase
# From Supabase Dashboard > Project Settings > Database
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SPRING_PROFILES_ACTIVE=supabase
